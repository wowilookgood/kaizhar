+void AddressSpace::HenResortUnclaim() {
+    if (hen_resort_claimed.exchange(false)) {
+        hen_resort_unclaim();
+    }
+}
+
+void AddressSpace::HenResortWakeWorker() {
+    {
+        std::scoped_lock lock{hen_worker_mutex};
+        hen_resort_wake = true;
+    }
+    hen_worker_wake.notify_all();
+}
+
+/// Under the compile lock, from whatever makes a copy in the making stale.
+void AddressSpace::HenResortNoteAbort(const char* why) {
+    const int state = hen_resort_state.load(std::memory_order_relaxed);
+    if (state < 1 || state > 3 || hen_resort_abort) {
+        return;
+    }
+    hen_resort_abort = true;
+    hen_resort_abort_why = why;
+    if (state == 3) {
+        // (the worker sleeps while the copy waits for the emulation thread)
+        hen_resort_state.store(5);
+        HenResortWakeWorker();
+    }
+}
+
+void AddressSpace::HenResortTick(u64 now_ns) {
+    if (!hen_resort || hen_resort_off || hen_tag == 0xffff || !hen_worker_started || !HenWorkerCompiles()) {
+        return;
+    }
+    const u64 count = hen_log_count.load(std::memory_order_relaxed);
+    if (hen_resort_window_ns == 0) {
+        hen_resort_window_ns = now_ns;
+        hen_resort_window_count = count;
+        hen_resort_window_runs = hen_resort_runs;
+    } else if (now_ns - hen_resort_window_ns >= HenResort::kWindowNs) {
+        hen_resort_window_blocks = count >= hen_resort_window_count ? count - hen_resort_window_count : 0;
+        hen_resort_window_ran = hen_resort_runs != hen_resort_window_runs;
+        hen_resort_window_known = true;
+        hen_resort_window_ns = now_ns;
+        hen_resort_window_count = count;
+        hen_resort_window_runs = hen_resort_runs;
+    }
+    const int state = hen_resort_state.load(std::memory_order_relaxed);
+    if (state == 3) {
+        // A copy that is ready and not taken: this JIT's core is not running (the change-over
+        // is at the start of a slice). It is not kept waiting, with its tables, for a slice
+        // that may never come.
+        const u64 ready = hen_resort_ready_ns.load(std::memory_order_relaxed);
+        if (ready != 0 && now_ns > ready && now_ns - ready > HenResort::kWindowNs) {
+            HenEmuLock hen_lock{*this};
+            hen_resort_idle_abandons++;  // (the next try waits twice as long)
+            HenResortNoteAbort("the JIT ran no slice for two seconds after the copy was ready");
+        }
+        return;
+    }
+    if (state != 0) {
+        return;
+    }
+    // A full buffer that can grow: asked for now, whatever the rules below say. The
+    // program is interpreting every new block until the change-over.
+    // The same from where the worker stops compiling what nobody asked for (87% of any
+    // size, HenAheadRoom): the growth is due at seven tenths, and if it has not come by then
+    // (the rules of the first seconds, a copy given up), it is not to wait for them any longer.
+    const bool full = (hen_full.load(std::memory_order_relaxed) ||
+                       (hen_buffer_grow &&
+                        static_cast<size_t>(code.offset()) + HenAheadRoom(16 * 1024 * 1024) > std::min(code_cache_size, mem.usable_size()))) &&
+                      HenCanGrow();
+    if (!full && (!hen_resort_window_known || !hen_resort_window_ran)) {
+        return;  // (not running: nothing to gain, and nobody to change over)
+    }
+    // (--jit-buffer-grow) A buffer smaller than the largest that is seven tenths full is
+    // re-sorted into one 32 MiB larger now, whatever the rules for an ordinary re-sort say: the
+    // copy is to be in use before the buffer is full (a full buffer is thrown away whole,
+    // ClearCache, which has never run on the console). A JIT that is compiling hard may have its
+    // copy given up ("code kept being compiled"); the next tick asks again.
+    bool grow = false;
+    if (hen_buffer_grow && hen_resort_at_ms < 0) {
+        constexpr size_t largest = size_t(124) << 20, step = size_t(32) << 20;
+        const size_t usable = std::min(code_cache_size, mem.usable_size());
+        const size_t used = static_cast<size_t>(code.offset());  // (read without the lock: a figure only)
+        const bool due = full ? (hen_resort_last_start_ns == 0 || now_ns - hen_resort_last_start_ns >= 200'000'000ull)
+                              : used >= usable / 10 * 7 &&
+                                    (hen_resort_last_start_ns == 0 || now_ns - hen_resort_last_start_ns >= 2'000'000'000ull);
+        if (usable < largest && due && !hen_parked.load(std::memory_order_relaxed)) {
+            grow = true;
+            hen_grow_target = std::min(largest, usable + step);
+        }
+    }
+    if (grow) {
+    } else if (hen_resort_at_ms >= 0) {
+        // (--jit-resort-at: one re-sort at that time whatever the rules say, and no other)
+        if (hen_resort_at_done || count == 0 || hen_parked.load(std::memory_order_relaxed) ||
+            now_ns - hen_resort_origin() < static_cast<u64>(hen_resort_at_ms) * 1'000'000ull) {
+            return;
+        }
+    } else {
+        HenResort::PolicyIn in{};
+        in.now_ns = now_ns;
+        in.last_start_ns = hen_resort_last_start_ns;
+        in.busy_last_ns = hen_resort_busy_last();
+        in.window_blocks = hen_resort_window_blocks;
+        in.window_known = hen_resort_window_known;
+        in.list_pending = hen_list_busy.load(std::memory_order_relaxed);
+        in.parked = hen_parked.load(std::memory_order_relaxed);
+        in.total_bytes = hen_log_bytes.load(std::memory_order_relaxed);
+        in.unsorted_bytes = hen_log_unsorted_bytes.load(std::memory_order_relaxed);
+        in.idle_abandons = hen_resort_idle_abandons;
+        if (HenResort::PolicyWait(in) != nullptr) {
+            return;
+        }
+    }
+    // (one copy in the making at a time, over all address spaces: they share the publish path)
+    if (!hen_resort_claim()) {
+        return;
+    }
+    hen_resort_claimed.store(true);
+    if (!grow) {
+        hen_grow_target = 0;
+    }
+    hen_resort_at_done = true;
+    hen_resort_last_start_ns = now_ns;
+    hen_resort_state.store(1);
+    HenResortWakeWorker();
+}
+
+bool AddressSpace::HenCanGrow() const {
+    constexpr size_t largest = size_t(124) << 20;
+    return hen_buffer_grow && hen_resort && !hen_resort_off && hen_resort_at_ms < 0 &&
+           hen_tag != 0xffff && hen_worker_started && HenWorkerCompiles() && !hen_parked.load(std::memory_order_relaxed) &&
+           std::min(code_cache_size, mem.usable_size()) < largest;
+}
+
+bool AddressSpace::HenSliceStartWanted() const {
+    // (the time is looked at here. Going into HenSliceStart, and so taking the compile
+    // lock, at every slice until the time has come gives Kid Icarus first reports at 21 and 65%
+    // with --jit-clear-at 40, 3950 ms of waiting for the lock, the worker's batches cut to 1.3
+    // blocks.)
+    return hen_full.load(std::memory_order_relaxed) || hen_clear_wanted.load(std::memory_order_relaxed) ||
+           (hen_jit_clear_at_ms >= 0 && !hen_clear_at_done &&
+            hen_jit_now_ns() >= hen_resort_origin() + static_cast<u64>(hen_jit_clear_at_ms) * 1'000'000ull);
+}
+
+/// The emulation thread, between two slices (see "A full code buffer" in address_space.h).
+void AddressSpace::HenSliceStart() {
+    const u64 origin = hen_resort_origin();  // (before now: it is set when first asked for)
+    const u64 now = std::max<u64>(hen_jit_now_ns(), origin);
+    HenEmuLock hen_lock{*this};
+    if (hen_jit_clear_at_ms >= 0 && !hen_clear_at_done &&
+        now - origin >= static_cast<u64>(hen_jit_clear_at_ms) * 1'000'000ull) {
+        hen_clear_at_done = true;
+        if (static_cast<size_t>(code.offset()) > static_cast<size_t>(prelude_info.end_of_prelude)) {
+            HenClearNow("asked for by --jit-clear-at");
+            return;
+        }
+    }
+    if (hen_clear_wanted.load(std::memory_order_relaxed)) {
+        HenClearNow("no room left for a block the interpreter cannot run");
+        return;
+    }
+    if (!hen_full.load(std::memory_order_relaxed)) {
+        return;
+    }
+    if (GetRemainingSize() >= hen_full_room) {
+        // (a larger buffer has been changed over to, just before this in Jit::Run; or the
+        // cache was cleared or parts of it were asked for by the program meanwhile)
+        std::printf("hen: jit full: JIT 0x%03x at %.1f s: room again after %.0f ms, %llu lookups answered \"interpret\" "
+                    "meanwhile; the buffer is %zu MiB now, %zu KiB in use\n",
+                    static_cast<unsigned>(hen_tag), (now - origin) / 1e9, (now > hen_full_since_ns ? now - hen_full_since_ns : 0) / 1e6,
+                    static_cast<unsigned long long>(hen_full_interpreted), std::min(code_cache_size, mem.usable_size()) >> 20,
+                    static_cast<size_t>(code.offset()) >> 10);
+        hen_full.store(false);
+        return;
+    }
+    if (HenCanGrow() && (now < hen_full_since_ns || now - hen_full_since_ns < hen_full_wait_ns)) {
+        if (hen_full_interpreted == 1) {
+            hen_full_interpreted++;  // (said once)
+            std::printf("hen: jit full: JIT 0x%03x at %.1f s: its %zu MiB code buffer is full (%zu KiB left); new blocks are "
+                        "interpreted until a larger buffer is in use\n",
+                        static_cast<unsigned>(hen_tag), (now - origin) / 1e9,
+                        std::min(code_cache_size, mem.usable_size()) >> 20, GetRemainingSize() >> 10);
+        }
+        return;
+    }
+    HenClearNow(HenCanGrow() ? "the buffer is full and no larger one was in use after three seconds"
+                             : "the buffer is full and cannot grow");
+}
+
+void AddressSpace::HenClearNow(const char* why) {
+    const u64 t0 = hen_jit_now_ns();
+    const size_t blocks = block_entries.size();
+    const size_t old_top = static_cast<size_t>(code.offset());
+    const size_t prelude_end = static_cast<size_t>(prelude_info.end_of_prelude);
+    const bool was_full = hen_full.load(std::memory_order_relaxed);
+    ClearCache();
+#if HEN_DEV
+    if (hen_resort_poison && old_top > prelude_end) {
+        // (--jit-resort-poison) Anything that still led into the old code would go on working
+        // by accident until new code was written over it: it is filled with an instruction
+        // that faults.
+        UnprotectCodeMemory();
+        u32* const write = mem.wptr() + prelude_end / sizeof(u32);
+        const size_t words = (old_top - prelude_end) / sizeof(u32);
+        for (size_t i = 0; i < words; i++) {
+            write[i] = 0xD4200000u | (0x57u << 5);  // BRK #0x57
+        }
+        mem.invalidate(mem.xptr() + prelude_end / sizeof(u32), words * sizeof(u32));
+        ProtectCodeMemory();
+        mem.rewind(prelude_end);
+    }
+#endif
+    hen_full.store(false);
+    hen_clear_wanted.store(false);
+    const u64 origin = hen_resort_origin();
+    const u64 now = std::max<u64>(hen_jit_now_ns(), origin);
+    std::printf("hen: jit clear: JIT 0x%03x at %.1f s: code cache cleared between two slices: %s; %zu blocks, %zu KiB thrown "
+                "away in %.1f ms%s; buffer %zu MiB\n",
+                static_cast<unsigned>(hen_tag), (now - origin) / 1e9, why, blocks, (old_top - prelude_end) >> 10,
+                (now - t0) / 1e6, was_full ? " (blocks had been interpreted for lack of room)" : "",
+                std::min(code_cache_size, mem.usable_size()) >> 20);
+}
+
+void AddressSpace::HenResortWork() {
+    // A copy's tables are ordinary allocations (the block tables of a title's main JIT
+    // come to tens of MiB). When the heap cannot give one, the re-sort is given up like any
+    // other that cannot be finished; otherwise the exception leaves the worker's thread and
+    // ends the program (seen in a session with the online modules on).
+    switch (hen_resort_state.load()) {
+    case 1:
+        try {
+            if (!HenResortBegin()) {
+                hen_resort_state.store(5);
+            }
+        } catch (const std::bad_alloc&) {
+            if (hen_resort_world != nullptr) {
+                hen_resort_world->fail = "no memory for the copy's tables";
+            }
+            hen_resort_off = true;  // (not asked for again: the memory is not to be had)
+            hen_resort_state.store(5);
+        }
+        break;
+    case 2:
+        try {
+            if (!HenResortStep()) {
+                hen_resort_state.store(5);
+            }
+        } catch (const std::bad_alloc&) {
+            hen_resort_world->fail = "no memory for the copy's tables";
+            hen_resort_off = true;
+            hen_resort_state.store(5);
+        }
+        break;
+    case 4:
+        HenResortFinish(true);
+        break;
+    case 5:
+        HenResortFinish(false);
+        break;
+    default:
+        break;
+    }
+    // (the mutex isn't fair: let the emulation thread have it)
+    while (hen_emu_waiting.load(std::memory_order_relaxed) != 0) {
+        std::this_thread::yield();
+    }
+}
+
+/// The worker: the second buffer, its prelude, and where the log stands. False: given up
+/// (the world, if there is one, says why).
+bool AddressSpace::HenResortBegin() {
+    HenResortWorld* const world = new HenResortWorld;
+    hen_resort_world = world;
+    world->number = hen_resort_number();
+    HEN_STAT(world->start_ns = hen_jit_now_ns();)
+    if (prelude_info.hen_rtd_literal == 0) {
+        world->fail = "this address space's prelude cannot be copied";
+        hen_resort_off = true;
+        return false;
+    }
+    // The buffer's size: the one in use, or a larger one when this re-sort is a growth.
+    const size_t target = hen_grow_target != 0 ? hen_grow_target : code_cache_size;
+    // (what the buffer in use can hold, which is less than its size if part of its address
+    // range was occupied when it was mapped: hen_jit.c, try_alias)
+    world->grow_from = hen_grow_target != 0 ? std::min(code_cache_size, mem.usable_size()) : 0;
+    if (hen_resort_spare != nullptr && hen_jit_usable_size(hen_resort_spare) != target) {
+        hen_jit_destroy(hen_resort_spare);
+        hen_resort_spare = nullptr;
+    }
+    if (hen_resort_spare == nullptr) {
+        hen_resort_spare = hen_jit_create(target);
+    }
+    unsigned long long map_ns = 0;
+    if (hen_resort_spare == nullptr || !hen_jit_resort_prepare(hen_resort_spare, &map_ns)) {
+        world->fail = "no second code buffer";
+        hen_resort_off = true;  // (not asked for again: the memory or the mapping is not to be had)
+        return false;
+    }
+    HEN_STAT(world->map_ns = map_ns;)
+    world->jit = hen_resort_spare;
+    world->w = hen_jit_wptr(world->jit);
+    world->x = hen_jit_xptr(world->jit);
+    world->usable = std::min(target, hen_jit_usable_size(world->jit));
+    static_assert(std::is_trivially_copyable_v<PreludeInfo> && sizeof(PreludeInfo) % sizeof(u64) == 0);
+    {
+        std::scoped_lock big{hen_compile_mutex};
+        hen_resort_abort = false;
+        hen_resort_abort_why = "";
+        if (hen_parked.load(std::memory_order_relaxed)) {
+            world->fail = "the process ended";
+            return false;
+        }
+        world->old_w = mem.wptr();
+        world->old_x = reinterpret_cast<CodePtr>(mem.xptr());
+        world->old_top = static_cast<size_t>(code.offset());
+        world->old_usable = std::min(code_cache_size, mem.usable_size());
+        world->snap = hen_log.size();
+        const size_t prelude_bytes = static_cast<size_t>(prelude_info.end_of_prelude);
+        if (world->usable < std::min(code_cache_size, mem.usable_size()) || prelude_bytes == 0 || prelude_bytes >= world->usable) {
+            world->fail = "the second code buffer is smaller";
+            hen_resort_off = true;
+            return false;
+        }
+        // The prelude: the same bytes at the same offsets, so every address of it is the old
+        // one moved by the distance between the two buffers.
+        std::memcpy(world->w, world->old_w, prelude_bytes);
+        const u64 old_base = mcl::bit_cast<u64>(world->old_x);
+        const u64 delta = mcl::bit_cast<u64>(world->x) - old_base;
+        u64 fields[sizeof(PreludeInfo) / sizeof(u64)];
+        std::memcpy(fields, &prelude_info, sizeof(PreludeInfo));
+        for (u64& field : fields) {
+            if (field >= old_base && field < old_base + prelude_bytes) {
+                field += delta;
+            }
+        }
+        std::memcpy(&world->prelude, fields, sizeof(PreludeInfo));
+        world->defer_stub = hen_defer_stub + delta;
+        const u64 rtd = mcl::bit_cast<u64>(world->prelude.return_to_dispatcher);
+        std::memcpy(reinterpret_cast<u8*>(world->w) + world->prelude.hen_rtd_literal, &rtd, sizeof(rtd));
+        world->top = prelude_bytes;
+        world->Mark(0, prelude_bytes);
+    }
+#if HEN_DEV
+    // (no word of the copied prelude may still be an address inside the old buffer)
+    for (size_t at = 0; at + 8 <= world->top; at += 4) {
+        u64 value;
+        std::memcpy(&value, reinterpret_cast<const u8*>(world->w) + at, sizeof(value));
+        // (within the old buffer's own length. With the copy's, which is longer when the
+        // buffer grows, whatever lay behind the old buffer counted as part of it.)
+        if (value >= mcl::bit_cast<u64>(world->old_x) && value < mcl::bit_cast<u64>(world->old_x) + world->old_usable) {
+            world->fail = "check failed: the copied prelude holds an address of the old buffer";
+            world->fail_at = at;
+            world->fail_is_check = true;
+            hen_resort_off = true;
+            return false;
+        }
+    }
+#endif
+    world->phase = 0;
+    hen_resort_state.store(2);
+    return true;
+}
+
+/// Written but not published code of the copy, to the HEN: when there is a piece's worth, or all of
+/// it. Not under the compile lock (the worker), except at the change-over, where it is a few
+/// blocks.
+void AddressSpace::HenResortPublish(HenResortWorld& world, bool all) {
+    if (world.dirty.empty() || (!all && world.dirty_bytes < static_cast<size_t>(hen_resort_chunk))) {
+        return;
+    }
+    for (const auto& [begin, end] : world.dirty) {
+        unsigned long long ns = 0, longest = 0;
+        unsigned requests = 0;
+        hen_jit_resort_publish(world.jit, begin, end - begin, &ns, &requests, &longest);
+        HEN_STAT(world.publish_ns += ns;
+        world.publish_requests += requests;
+        world.publish_longest_ns = std::max<u64>(world.publish_longest_ns, longest);)
+    }
+    world.dirty.clear();
+    world.dirty_bytes = 0;
+}
+
+/// Under the compile lock. One block of the code in use into the copy at new_offset: its bytes,
+/// its record, its place in the copy's tables. sorted: the copy's block table has it already.
+bool AddressSpace::HenResortAppend(HenResortWorld& world, const HenLogEntry& entry, size_t new_offset, bool sorted) {
+    const auto old_info = block_infos.find(entry.entry);
+    if (old_info == block_infos.end() || old_info->second.size != entry.size || (entry.size & 3) != 0 || entry.size == 0) {
+        world.fail = "a block of the log has no record";
+        world.fail_at = entry.descriptor;
+        return false;
+    }
+    if (new_offset + entry.size + 1024 * 1024 > world.usable) {
+        world.fail = "the second code buffer is full";
+        world.fail_at = entry.descriptor;
+        return false;
+    }
+    const size_t old_offset = static_cast<size_t>(entry.entry - world.old_x);
+    std::memcpy(reinterpret_cast<u8*>(world.w) + new_offset, reinterpret_cast<const u8*>(world.old_w) + old_offset, entry.size);
+    const CodePtr new_entry = reinterpret_cast<CodePtr>(world.x) + new_offset;
+    const IR::LocationDescriptor descriptor{entry.descriptor};
+    EmittedBlockInfo info = old_info->second;
+    info.entry_point = new_entry;
+    const u64 delta = mcl::bit_cast<u64>(new_entry) - mcl::bit_cast<u64>(entry.entry);
+    for (auto patch = info.fastmem_patch_info.begin(); patch != info.fastmem_patch_info.end(); ++patch) {
+        patch.value().fc.call_pc += delta;
+    }
+    world.infos.insert_or_assign(new_entry, std::move(info));
+    world.reverse.insert_or_assign(world.reverse.end(), new_entry, descriptor);
+    world.log.push_back({entry.descriptor, new_entry, entry.size, entry.speculative});
+    HEN_STAT(world.old_offsets.push_back(static_cast<u32>(old_offset));
+    world.figure = HenResort::FigureAdd(world.figure, entry.descriptor, new_offset);)
+    world.Mark(new_offset, new_offset + entry.size);
+    if (sorted) {
+        world.sorted_blocks++;
+        world.sorted_bytes += entry.size;
+    } else {
+        world.entries.insert_or_assign(descriptor, new_entry);
+        world.published.insert_or_assign(descriptor, new_entry);
+        world.appended_blocks++;
+        world.appended_bytes += entry.size;
+    }
+    return true;
+}
+
+/// The calls into the prelude and the link sites of a block of the copy, for where it lies now.
+/// A link to a block that is in the copy is a direct branch (or the block's address, for a
+/// return stack entry); one to a block that is not goes through the target's link slot of the
+/// copy (a compact site: by way of the target's stub in the copy), and is recorded for
+/// HenUpgradeLinks as in the code in use.
+bool AddressSpace::HenResortLink(HenResortWorld& world, IR::LocationDescriptor descriptor, CodePtr new_entry) {
+    const auto found = world.infos.find(new_entry);
+    if (found == world.infos.end()) {
+        world.fail = "a block of the copy has no record";
+        world.fail_at = descriptor.Value();
+        return false;
+    }
+    const EmittedBlockInfo& info = found->second;
+    HenLinkRelocations(info, new_entry, world.w, world.x, world.prelude);
+
+    const auto slot_of = [&world](IR::LocationDescriptor target) -> u64 {
+        if (const auto have = world.slot_of.find(target); have != world.slot_of.end()) {
+            return mcl::bit_cast<u64>(have->second);
+        }
+        const auto there = world.entries.find(target);
+        const u64 entry = there != world.entries.end() ? mcl::bit_cast<u64>(there->second) : 0;
+        world.slots.push_back({entry, entry != 0 ? entry : mcl::bit_cast<u64>(world.prelude.return_to_dispatcher)});
+        std::array<u64, 2>* const slot = &world.slots.back();
+        world.slot_of.emplace(target, slot);
+        return mcl::bit_cast<u64>(slot);
+    };
+    constexpr size_t stub_bytes = HenResort::kStubWords * sizeof(u32);
+    const auto stub_of = [&](IR::LocationDescriptor target) -> u64 {
+        if (const auto have = world.stub_of.find(target); have != world.stub_of.end()) {
+            return mcl::bit_cast<u64>(have->second);
+        }
+        if (world.stub_next == nullptr || static_cast<size_t>(world.stub_end - world.stub_next) < stub_bytes) {
+            // A new run of stubs at the end of the copy's code, zeroed (what is never written
+            // there must not look like an instruction to HenResort::CheckRange).
+            const size_t run = 400 * stub_bytes;
+            if (world.top + run + 1024 * 1024 > world.usable) {
+                return 0;
+            }
+            std::memset(reinterpret_cast<u8*>(world.w) + world.top, 0, run);
+            world.stub_next = reinterpret_cast<CodePtr>(world.x) + world.top;
+            world.stub_end = world.stub_next + run;
+            world.top += run;
+        }
+        const CodePtr stub = world.stub_next;
+        world.stub_next += stub_bytes;
+        HenWriteStub(world.w, world.x, stub, slot_of(target), static_cast<u32>(target.Value()), hen_pc_offset,
+                     world.prelude.hen_exit_unlinked ? world.prelude.hen_exit_unlinked : world.prelude.return_to_dispatcher);
+        world.stub_of.emplace(target, stub);
+        HEN_STAT(world.stubs++;)
+        const size_t at = static_cast<size_t>(stub - reinterpret_cast<CodePtr>(world.x));
+        world.Mark(at, at + stub_bytes);
+        return mcl::bit_cast<u64>(stub);
+    };
+
+    for (const auto& [target, list] : info.block_relocations) {
+        const auto there = world.entries.find(target);
+        const u64 direct = hen_direct_links && there != world.entries.end() ? mcl::bit_cast<u64>(there->second) : 0;
+        for (const auto& [ptr_offset, type] : list) {
+            const CodePtr site = new_entry + ptr_offset;
+            const std::uint8_t kind = type == BlockRelocationType::BranchCompact ? HenResort::LinkCompact
+                                    : type == BlockRelocationType::Branch       ? HenResort::LinkBranch
+                                                                                : HenResort::LinkMove;
+            u64 through = 0;
+            if (direct == 0) {
+                through = kind == HenResort::LinkCompact ? stub_of(target) : slot_of(target);
+                if (through == 0) {
+                    world.fail = "the second code buffer is full";
+                    world.fail_at = descriptor.Value();
+                    return false;
+                }
+                if (hen_direct_links) {
+                    world.pending[target].push_back({site, type, new_entry});
+                }
+                HEN_STAT(world.slot_sites++;)
+            } else {
+                HEN_STAT(world.direct_sites++;)
+            }
+            u32* const words = world.w + static_cast<size_t>(site - reinterpret_cast<CodePtr>(world.x)) / sizeof(u32);
+            if (!HenResort::WriteSite(words, kind, mcl::bit_cast<u64>(site), direct, through, 16, 17)) {
+                world.fail = "a link site of the copy is out of a branch's reach";
+                world.fail_at = descriptor.Value();
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+/// Under the compile lock. The blocks of the log in use that the copy does not have yet, at the
+/// end of the copy in the order compiled, at most limit of them; a target that arrives this way
+/// has its link slot of the copy set, and the copy's sites that wait for it noted for
+/// HenUpgradeLinks. False: given up.
+bool AddressSpace::HenResortAppendNew(HenResortWorld& world, size_t limit) {
+    const size_t first = world.log.size();
+    size_t added = 0;
+    HEN_STAT(const u64 t0 = hen_jit_now_ns();)
+    while (world.log_done < hen_log.size() && added < limit && hen_emu_waiting.load(std::memory_order_relaxed) == 0) {
+        const HenLogEntry entry = hen_log[world.log_done++];
+        if (Get(IR::LocationDescriptor{entry.descriptor}) != entry.entry) {
+            continue;  // (thrown away since it was compiled)
+        }
+        const size_t at = world.top;
+        if (!HenResortAppend(world, entry, at, false)) {
+            return false;
+        }
+        world.top = at + entry.size;
+        added++;
+    }
+    HEN_STAT(const u64 t1 = hen_jit_now_ns();)
+    for (size_t i = first; i < world.log.size(); i++) {
+        const IR::LocationDescriptor descriptor{world.log[i].descriptor};
+        if (!HenResortLink(world, descriptor, world.log[i].entry)) {
+            return false;
+        }
+        if (const auto slot = world.slot_of.find(descriptor); slot != world.slot_of.end()) {
+            (*slot->second)[0] = mcl::bit_cast<u64>(world.log[i].entry);
+            (*slot->second)[1] = mcl::bit_cast<u64>(world.log[i].entry);
+        }
+        if (hen_direct_links && world.pending.contains(descriptor)) {
+            world.ready.push_back(descriptor);
+        }
+    }
+    HEN_STAT(world.copy_ns += t1 - t0;
+    world.link_ns += hen_jit_now_ns() - t1;)
+    return true;
+}
+
+/// Development builds: the copy's blocks from entry from_log of its log on, each against the
+/// block it was copied from, and everything the copy holds against the copy's bounds. nullptr,
+/// or what is wrong. Reads the old write area's words outside link sites, which never change
+/// (an invalidated block's first words do: the caller ignores the answer when blocks were
+/// invalidated meanwhile).
+const char* AddressSpace::HenResortCheck([[maybe_unused]] HenResortWorld& world, [[maybe_unused]] size_t from_log, [[maybe_unused]] u64* where) {
+#if HEN_DEV
+    const HenResort::Bounds bounds{mcl::bit_cast<u64>(world.x), mcl::bit_cast<u64>(world.old_x),
+                                   static_cast<u64>(world.prelude.end_of_prelude), world.top};
+    std::vector<HenResort::Site> sites;
+    std::vector<std::uint8_t> marks;
+    for (size_t i = from_log; i < world.log.size(); i++) {
+        const HenLogEntry& entry = world.log[i];
+        *where = entry.descriptor;
+        const auto info = world.infos.find(entry.entry);
+        const auto listed = world.entries.find(IR::LocationDescriptor{entry.descriptor});
+        const auto reversed = world.reverse.find(entry.entry);
+        const auto published = world.published.find(IR::LocationDescriptor{entry.descriptor});
+        if (info == world.infos.end() || info->second.entry_point != entry.entry || info->second.size != entry.size ||
+            listed == world.entries.end() || listed->second != entry.entry || reversed == world.reverse.end() ||
+            reversed->second.Value() != entry.descriptor || published == world.published.end() || published->second != entry.entry) {
+            return "the copy's tables do not agree about a block";
+        }
+        sites.clear();
+        for (const auto& [ptr_offset, target] : info->second.relocations) {
+            sites.push_back({static_cast<std::uint32_t>(ptr_offset), HenResort::Prelude, 0, 0});
+        }
+        for (const auto& [target, list] : info->second.block_relocations) {
+            const auto there = world.entries.find(target);
+            const u64 direct = hen_direct_links && there != world.entries.end() ? mcl::bit_cast<u64>(there->second) : 0;
+            const auto slot = world.slot_of.find(target);
+            const u64 through = slot != world.slot_of.end() ? mcl::bit_cast<u64>(slot->second) : 0;
+            for (const auto& [ptr_offset, type] : list) {
+                const std::uint8_t kind = type == BlockRelocationType::BranchCompact ? HenResort::LinkCompact
+                                        : type == BlockRelocationType::Branch       ? HenResort::LinkBranch
+                                                                                    : HenResort::LinkMove;
+                sites.push_back({static_cast<std::uint32_t>(ptr_offset), kind, direct, through});
+            }
+        }
+        const size_t new_offset = static_cast<size_t>(entry.entry - reinterpret_cast<CodePtr>(world.x));
+        std::uint32_t at = 0;
+        const char* const why = HenResort::CheckBlock(world.w + new_offset / 4, world.old_w + world.old_offsets[i] / 4, entry.size,
+                                                      mcl::bit_cast<u64>(entry.entry), mcl::bit_cast<u64>(world.old_x) + world.old_offsets[i],
+                                                      sites.data(), sites.size(), bounds, world.w, marks, &at, 16, 17);
+        if (why != nullptr) {
+            return why;
+        }
+    }
+    *where = 0;
+    if (world.entries.size() != world.log.size() || world.infos.size() != world.log.size() || world.reverse.size() != world.log.size() ||
+        world.published.size() != world.log.size()) {
+        return "the copy's tables are not of one size";
+    }
+    {
+        const u64 from = std::max<u64>(world.checked_top, static_cast<u64>(world.prelude.end_of_prelude));
+        u64 at = 0;
+        if (const char* const why = HenResort::CheckRange(world.w, from, world.top, bounds, &at)) {
+            *where = at;
+            return why;
+        }
+    }
+    for (const auto& slot : world.slots) {
+        if (!HenResort::InCopy(slot[0], bounds) || !HenResort::InCopy(slot[1], bounds) || slot[1] == 0) {
+            return "a link slot of the copy holds an address outside the copy";
+        }
+    }
+    for (const auto& [target, stub] : world.stub_of) {
+        if (!HenResort::InCopy(mcl::bit_cast<u64>(stub), bounds)) {
+            return "a link stub of the copy is outside the copy";
+        }
+    }
+    for (const auto& [target, list] : world.pending) {
+        for (const HenSlotSite& site : list) {
+            if (!HenResort::InCopy(mcl::bit_cast<u64>(site.site), bounds) || !world.infos.contains(site.block)) {
+                return "a link site recorded for the copy is outside the copy";
+            }
+        }
+    }
+    u64 fields[sizeof(PreludeInfo) / sizeof(u64)];
+    std::memcpy(fields, &world.prelude, sizeof(PreludeInfo));
+    for (const u64 field : fields) {
+        if (field >= mcl::bit_cast<u64>(world.old_x) && field < mcl::bit_cast<u64>(world.old_x) + world.old_usable) {
+            return "the copy's prelude addresses name the old buffer";
+        }
+    }
+#endif
+    return nullptr;
+}
+
+/// The worker: one bounded step. False: given up (world.fail says why).
+bool AddressSpace::HenResortStep() {
+    HenResortWorld& world = *hen_resort_world;
+    const auto stale = [&]() {
+        if (hen_resort_abort || hen_parked.load(std::memory_order_relaxed)) {
+            world.fail = hen_resort_abort ? hen_resort_abort_why : "the process ended";
+            return true;
+        }
+        return false;
+    };
+    switch (world.phase) {
+    case 0: {
+        // The blocks alive now, in the order compiled.
+        std::scoped_lock big{hen_compile_mutex};
+        if (stale()) {
+            return false;
+        }
+        if (world.items.capacity() < world.snap) {
+            world.items.reserve(world.snap);
+        }
+        for (size_t n = 0; world.cursor < world.snap && n < 4096 && hen_emu_waiting.load(std::memory_order_relaxed) == 0; world.cursor++, n++) {
+            const HenLogEntry& entry = hen_log[world.cursor];
+            if (Get(IR::LocationDescriptor{entry.descriptor}) != entry.entry) {
+                continue;  // (invalidated since it was compiled)
+            }
+            world.items.push_back({entry.descriptor, static_cast<std::uint32_t>(entry.entry - world.old_x), entry.size, 0,
+                                   static_cast<std::uint32_t>(world.cursor), entry.speculative});
+        }
+        if (world.cursor == world.snap) {
+            world.phase = 1;
+        }
+        return true;
+    }
+    case 1: {
+        // Their order and places, and the copy's block table: nothing of the code in use is read.
+        HEN_STAT(const u64 t0 = hen_jit_now_ns();)
+        HenResort::Sort(world.items);
+        const u64 end = HenResort::Assign(world.items, world.top);
+        if (end + 4 * 1024 * 1024 > world.usable) {
+            world.fail = "the second code buffer is full";
+            return false;
+        }
+        world.top = static_cast<size_t>(end);
+        const size_t room = world.items.size() + world.items.size() / 4 + 4096;
+        world.entries.reserve(room);
+        world.published.reserve(room);
+        world.infos.reserve(room);
+        world.log.reserve(room);
+        HEN_STAT(world.old_offsets.reserve(room);)
+        for (const HenResort::Item& item : world.items) {
+            const CodePtr entry = reinterpret_cast<CodePtr>(world.x) + item.new_offset;
+            world.entries.insert_or_assign(IR::LocationDescriptor{item.descriptor}, entry);
+            world.published.insert_or_assign(IR::LocationDescriptor{item.descriptor}, entry);
+        }
+        HEN_STAT(world.figure = HenResort::FigureStart(hen_tag);)
+        world.cursor = 0;
+        world.phase = 2;
+        HEN_STAT(world.copy_ns += hen_jit_now_ns() - t0;)
+        return true;
+    }
+    case 2: {
+        {
+            std::scoped_lock big{hen_compile_mutex};
+            if (stale()) {
+                return false;
+            }
+            const size_t first = world.cursor;
+            HEN_STAT(const u64 t0 = hen_jit_now_ns();)
+            for (size_t n = 0; world.cursor < world.items.size() && n < 256 && hen_emu_waiting.load(std::memory_order_relaxed) == 0; world.cursor++, n++) {
+                const HenResort::Item& item = world.items[world.cursor];
+                const HenLogEntry entry{item.descriptor, world.old_x + item.old_offset, item.size, item.speculative};
+                if (!HenResortAppend(world, entry, item.new_offset, true)) {
+                    return false;
+                }
+            }
+            HEN_STAT(const u64 t1 = hen_jit_now_ns();)
+            for (size_t k = first; k < world.cursor; k++) {
+                const HenResort::Item& item = world.items[k];
+                if (!HenResortLink(world, IR::LocationDescriptor{item.descriptor}, reinterpret_cast<CodePtr>(world.x) + item.new_offset)) {
+                    return false;
+                }
+            }
+            HEN_STAT(world.copy_ns += t1 - t0;
+            world.link_ns += hen_jit_now_ns() - t1;)
+            if (world.cursor == world.items.size()) {
+                world.log_done = world.snap;
+                world.phase = 3;
+            }
+        }
+        HenResortPublish(world, world.phase == 3);
+        return true;
+    }
+    default: {
+        // What was compiled since the snapshot, in rounds, until a round finds nothing new;
+        // then the copy is the emulation thread's.
+        bool level = false;
+        {
+            std::scoped_lock big{hen_compile_mutex};
+            if (stale()) {
+                return false;
+            }
+            if (!HenResortAppendNew(world, 256)) {
+                return false;
+            }
+            level = world.log_done == hen_log.size();
+        }
+        HenResortPublish(world, true);
+        if (!level) {
+            return true;
+        }
+        HEN_STAT(const u64 t0 = hen_jit_now_ns();)
+        u64 where = 0;
+        const char* const wrong = HenResortCheck(world, world.checked, &where);
+        HEN_STAT(world.check_ns += hen_jit_now_ns() - t0;
+        const unsigned number = world.number;
+        size_t ready_blocks = 0;
+        double ready_ms = 0;)
+        {
+        std::scoped_lock big{hen_compile_mutex};
+        if (stale()) {
+            return false;
+        }
+        if (wrong != nullptr) {
+            world.fail = wrong;
+            world.fail_at = where;
+            world.fail_is_check = true;
+            hen_resort_off = true;
+            return false;
+        }
+        world.checked = world.log.size();
+        world.checked_top = world.top;
+        if (world.log_done != hen_log.size()) {
+            // (more was compiled during the check)
+            if (++world.rounds > HenResort::kRounds) {
+                world.fail = "code kept being compiled while the copy was made";
+                return false;
+            }
+            return true;
+        }
+        world.ready_ns = hen_jit_now_ns();
+        hen_resort_ready_ns.store(world.ready_ns);
+        HenResortUnclaim();  // (built and published: another address space may begin its copy)
+        HEN_STAT(ready_blocks = world.log.size();
+        ready_ms = (world.ready_ns - world.start_ns) / 1e6;)
+        hen_resort_state.store(3);
+        }
+        // (The copy is the emulation thread's from here: nothing of the world is read. This line
+        // comes before the full one, which follows the change-over: if the program ends between
+        // the two, it is what says a re-sort was the last thing done.)
+        HEN_STAT(std::printf("hen: resort: #%u JIT 0x%03x: a copy of %zu blocks is ready after %.0f ms; the emulation thread changes over at its "
+                    "next slice\n",
+                    number, static_cast<unsigned>(hen_tag), ready_blocks, ready_ms);)
+        return true;
+    }
+    }
+}
+
+void AddressSpace::HenResortSwitch() {
+    HEN_STAT(const u64 t0 = hen_jit_now_ns();)
+    HenEmuLock hen_lock{*this};
+    if (hen_resort_state.load() != 3 || hen_resort_world == nullptr) {
+        return;
+    }
+    HenResortWorld& world = *hen_resort_world;
+    const auto give_up = [&](const char* why, bool check) {
+        world.fail = why;
+        world.fail_is_check = check;
+        if (check) {
+            hen_resort_off = true;
+        }
+        hen_resort_state.store(5);
+        HenResortWakeWorker();
+    };
+    if (hen_resort_abort || hen_parked.load(std::memory_order_relaxed)) {
+        give_up(hen_resort_abort ? hen_resort_abort_why : "the process ended", false);
+        return;
+    }
+    if (hen_on_worker || protect_deferred || !hen_batch_new.empty() || !hen_deferred_slots.empty() ||
+        world.old_w != mem.wptr() || world.old_x != reinterpret_cast<CodePtr>(mem.xptr())) {
+        give_up("the address space was not at rest at the change-over", false);
+        return;
+    }
+    if (hen_log.size() - world.log_done > HenResort::kCatchUp) {
+        // Too much has been compiled since the worker's last round to add here: its again.
+        if (++world.rounds > HenResort::kRounds) {
+            give_up("code kept being compiled while the copy was made", false);
+            return;
+        }
+        hen_resort_state.store(2);
+        HenResortWakeWorker();
+        return;
+    }
+    const size_t log_before = world.log.size();
+    try {
+        while (world.log_done < hen_log.size()) {
+            if (!HenResortAppendNew(world, ~size_t(0))) {
+                give_up(world.fail, false);
+                return;
+            }
+        }
+    } catch (const std::bad_alloc&) {
+        // (the copy's tables could not grow; nothing of the code in use has changed yet)
+        give_up("no memory for the copy's tables", false);
+        return;
+    }
+    hen_resort_at_switch = world.log.size() - log_before;
+#if HEN_DEV
+    if (hen_resort_at_switch != 0) {
+        u64 where = 0;
+        if (const char* const wrong = HenResortCheck(world, log_before, &where)) {
+            world.fail_at = where;
+            give_up(wrong, true);
+            return;
+        }
+    }
+#endif
+    HenResortPublish(world, true);
+
+    // From here on nothing can fail: the copy becomes the code in use, and the world keeps what
+    // the old code needed for the worker to free.
+    world.jit = mem.HenSwap(world.jit);
+    code_cache_size = world.usable;  // (the same unless this was a growth)
+    hen_resort_spare = nullptr;  // (it is the buffer in use now; the worker decides about the old one)
+    hen_resort_idle_abandons = 0;
+    code.~CodeGenerator();
+    new (&code) oaknut::CodeGenerator(mem.wptr(), mem.xptr());
+    code.set_offset(static_cast<std::ptrdiff_t>(world.top));
+    std::swap(prelude_info, world.prelude);
+    std::swap(hen_defer_stub, world.defer_stub);
+    block_entries.swap(world.entries);
+    {
+        std::scoped_lock lookup{hen_lookup_mutex};
+        hen_published.swap(world.published);
+    }
+    reverse_block_entries.swap(world.reverse);
+    block_infos.swap(world.infos);
+    block_references.swap(world.references);
+    hen_link_slots.swap(world.slots);
+    hen_link_slot_of.swap(world.slot_of);
+    hen_link_stub_of.swap(world.stub_of);
+    hen_tombstoned.swap(world.tombstoned);
+    hen_pending_sites.swap(world.pending);
+    hen_ready_targets.swap(world.ready);
+    hen_ready_count.store(hen_ready_targets.size(), std::memory_order_relaxed);
+    hen_stub_next = world.stub_next;
+    hen_stub_end = world.stub_end;
+    hen_stub_dirty = world.stub_next;
+    hen_log.swap(world.log);
+    hen_log_count.store(hen_log.size(), std::memory_order_relaxed);
+    hen_log_bytes.store(world.sorted_bytes + world.appended_bytes, std::memory_order_relaxed);
+    hen_log_unsorted_bytes.store(world.appended_bytes, std::memory_order_relaxed);
+    HenResortCounts(world.sorted_blocks, world.sorted_bytes, world.appended_blocks, world.appended_bytes);
+    hen_resort_window_count = hen_log.size();
+    // (the dispatcher's table holds entry points of the old code; not counted as "emptied",
+    // which is the report's word for invalidations)
+    for (size_t i = 0; i < dispatch_table_size; i++) {
+        dispatch_table[i] = {~u64(0), nullptr};
+    }
+    HEN_STAT(hen_resort_pause_ns = hen_jit_now_ns() - t0;)
+    hen_resort_state.store(4);
+    HenResortWakeWorker();
+}
+
+/// The worker: the end of a re-sort either way. Frees what is no longer needed, reports, and
+/// lets the next one begin.
+void AddressSpace::HenResortFinish(bool switched) {
+    HenResortWorld* world = nullptr;
+    const char* abort_why = "";
+    {
+        std::scoped_lock big{hen_compile_mutex};
+        world = hen_resort_world;
+        hen_resort_world = nullptr;
+        abort_why = hen_resort_abort ? hen_resort_abort_why : "";
+    }

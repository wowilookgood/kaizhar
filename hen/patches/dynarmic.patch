+// (Azahar's Switch 2 port) Live FPSR (fpsr_manager.cpp): the host register's bits into the
+// state before a call into the emulator, and the register zeroed after it.
+static void HenFoldFpsr(oaknut::CodeGenerator& code, oaknut::WReg w, oaknut::XReg x) {
+    using namespace oaknut::util;
+    if (!FpsrManager::Live()) {
+        return;
+    }
+    code.LDR(w, Xstate, offsetof(A32JitState, fpsr));
+    code.MRS(x, oaknut::SystemReg::FPSR);
+    code.ORR(w, w, x.toW());
+    code.STR(w, Xstate, offsetof(A32JitState, fpsr));
+}
+static void HenZeroFpsr(oaknut::CodeGenerator& code) {
+    using namespace oaknut::util;
+    if (FpsrManager::Live()) {
+        code.MSR(oaknut::SystemReg::FPSR, XZR);
+    }
+}

+bool AddressSpace::HenEmitAhead(IR::LocationDescriptor descriptor, EmittedBlockInfo* out, bool speculative) {
+    if (hen_not_code.contains(descriptor)) {
+        return false;
+    }
+    // Memory that isn't there or is still zero (a module not loaded yet) would compile, to
+    // code that is wrong once the module is loaded: wait until the program gets there.
+    const std::optional<u32> first_word = HenReadCode(static_cast<u32>(descriptor.Value()) & ~u32(3));
+    if (!first_word || *first_word == 0) {
+        return false;
+    }
+    const auto start = code.offset();
+    if (!hen_on_worker) {  // (the worker's thread always throws: hen_assert_throws_on_this_thread)
+        hen_assert_throws = 1;
+    }
+    HEN_TRACE("m+ %016llx\n", static_cast<unsigned long long>(descriptor.Value()));
+    try {
+        IR::LocationDescriptor end{0};
+        if (std::unique_ptr<HenTranslated> made = HenTakeTranslation(descriptor)) {
+            end = made->end;
+            *out = Emit(std::move(made->block));
+        } else {
+            // (timed apart: the CompileTimer in GetOrEmit can't see inside this call, and
+            // counted all of it as translation)
+            const auto t0 = hen_jit_now_ns();
+            IR::Block ir_block = hen_on_worker ? HenGenerateIRQuiet(descriptor) : GenerateIR(descriptor);
+            const auto t1 = hen_jit_now_ns();
+            end = ir_block.EndLocation();
+            *out = Emit(std::move(ir_block));
+            if (!hen_on_worker) {
+                hen_jit_note_split(t1 - t0, hen_jit_now_ns() - t1);
+            }
+        }
+        if (!hen_on_worker) {
+            hen_assert_throws = 0;
+        }
+        HenRecord(descriptor, end, speculative);
+        HEN_TRACE("m- %016llx%s\n", static_cast<unsigned long long>(descriptor.Value()), hen_on_worker ? " w" : "");
+        return true;
+    } catch (int) {
+        HEN_TRACE("m! %016llx\n", static_cast<unsigned long long>(descriptor.Value()));
+        // The translator or an emitter gave up (an instruction the backend doesn't have, which
+        // real programs don't use): the bytes weren't code. If the program does get there, the
+        // normal path compiles it and reports the problem.
+        code.set_offset(start);
+        if (!hen_on_worker) {
+            hen_assert_throws = 0;
+            hen_not_code.insert(descriptor);
+        }
+        return false;
+    }

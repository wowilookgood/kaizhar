+static void HenFoldFpsr(oaknut::CodeGenerator& code, oaknut::WReg w, oaknut::XReg x) {
+    using namespace oaknut::util;
+    if (!FpsrManager::Live()) {
+        return;
+    }
+    code.LDR(w, Xstate, offsetof(A32JitState, fpsr));
+    code.MRS(x, oaknut::SystemReg::FPSR);
+    code.ORR(w, w, x.toW());
+    code.STR(w, Xstate, offsetof(A32JitState, fpsr));

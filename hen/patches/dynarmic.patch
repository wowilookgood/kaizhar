+// (Azahar's Switch 2 port) See the direct links in HenWriteLinkSites: an invalidated block's
+// first four instructions become "set the program counter, go to the dispatcher", which is
+// what an unlinked site does. Sites that branch straight to the block, and return-stack
+// entries that hold its address, then end up at whatever the dispatcher finds for that
+// location. The rest of the block's state (the upper location descriptor) is already what
+// the block expects whenever something branches to it.
+void AddressSpace::HenTombstone(IR::LocationDescriptor descriptor, CodePtr entry_point) {
+    using namespace oaknut;
+    using namespace oaknut::util;
+
+    if (!hen_direct_links || !hen_link_table) {
+        return;
+    }
+    const auto info = block_infos.find(entry_point);
+    ASSERT(info != block_infos.end() && info->second.size >= 4 * sizeof(u32));
+    CodeGenerator c{mem.wptr(), mem.xptr()};
+    c.set_xptr(reinterpret_cast<u32*>(entry_point));
+    const u32 pc = static_cast<u32>(descriptor.Value());
+    c.dw(0x52800000u | ((pc & 0xffff) << 5) | 16u);                 // MOVZ W16, #lo
+    c.dw(0x72a00000u | (((pc >> 16) & 0xffff) << 5) | 16u);         // MOVK W16, #hi, LSL #16
+    c.STR(Wscratch0, Xstate, hen_pc_offset);

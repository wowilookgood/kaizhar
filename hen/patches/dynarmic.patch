+    std::optional<u32> HenReadCode(u32 vaddr) const override {
+        if (conf.page_table != nullptr && !conf.absolute_offset_page_table) {
+            const std::uint8_t* const page = (*conf.page_table)[vaddr >> A32::UserConfig::PAGE_BITS];

+// (Azahar's Switch 2 port) Live mode, A32 only.
+//
+// Upstream zeroes the host's FPSR before the first floating-point operation of every block
+// (MSR) and reads it back into the state at the end of the block and before every memory
+// access (MRS). Those two instructions are slow on the console's cores: a block of four
+// single-precision operations took 70 cycles, and they were the hottest generated code in a
+// float loop.
+//
+// The cumulative exception bits are sticky in the guest's register and in the host's alike,
+// so the host register can simply stay in use from block to block. The rule while generated
+// code runs: the guest's cumulative bits are (state.fpsr | host FPSR). The entry code
+// (a32_address_space.cpp) zeroes the host register, the exit code folds it into the state.
+// Inside a block the register is read only where the guest reads its FPSCR, and anything
+// that may leave bits there that are not the guest's (a call into the emulator, a packed
+// saturating operation) folds first and marks the register dirty: it is zeroed again before
+// the next floating-point operation, or at the end of the block. The out-of-line memory
+// calls fold and zero inside their own trampolines, so an inline memory access costs nothing.
+#if defined(__SWITCH__)
+extern "C" int hen_live_fpsr;  // hen/jit/hen_jit.c; --no-live-fpsr
+#else
+static const int hen_live_fpsr = 0;
+#endif
+
+bool FpsrManager::Live() {
+    return hen_live_fpsr != 0;
+}
+
+void FpsrManager::Sync() {
+    if (!Live()) {
+        Spill();
+        return;
+    }
+    if (!dirty) {
+        code.LDR(Wscratch0, Xstate, state_fpsr_offset);
+        code.MRS(Xscratch1, oaknut::SystemReg::FPSR);
+        code.ORR(Wscratch0, Wscratch0, Wscratch1);
+        code.STR(Wscratch0, Xstate, state_fpsr_offset);
+    }
+}
+
+void FpsrManager::EndOfBlock() {
+    if (!Live()) {
+        Spill();
+        return;
+    }
+    if (dirty) {
+        code.MSR(oaknut::SystemReg::FPSR, XZR);
+        dirty = false;
+    }
+}
+
+void FpsrManager::BeforeInlineMemoryAccess() {
+    if (!Live()) {
+        Spill();
+    }
+}
+
+void FpsrManager::Overwrite() {
+    if (!Live()) {
+        fpsr_loaded = false;
+        return;
+    }
+    // (the guest wrote its register: the state is about to hold the new bits, nothing else counts)
+    code.MSR(oaknut::SystemReg::FPSR, XZR);
+    dirty = false;
+}
+
 void FpsrManager::Spill() {
+    if (Live()) {
+        Sync();
+        dirty = true;
+        return;
+    }
     if (!fpsr_loaded)
         return;
 

+bool AddressSpace::HenHash(u32 pc, u32 words, u32& hash) const {
+    u32 h = 2166136261u;
+    for (u32 i = 0; i < words; i++) {
+        const std::optional<u32> word = HenReadCode((pc & ~u32(3)) + 4 * i);
+        if (!word) {
+            return false;
+        }
+        h = (h ^ *word) * 16777619u;
+        h ^= h >> 15;
+    }
+    hash = h;
+    return true;
+}
+
+void AddressSpace::HenRecord(IR::LocationDescriptor descriptor, IR::LocationDescriptor end_location, bool speculative) const {
+#if defined(__SWITCH__)
+    if (hen_tag == 0xffff) {
+        return;
+    }
+    const u32 pc = static_cast<u32>(descriptor.Value());
+    const u32 end = static_cast<u32>(end_location.Value());
+    if (descriptor.Value() & (u64(4) << 32)) {
+        return;  // (A32: a single-stepping block)
+    }
+    if (end <= pc) {
+        return;
+    }
+    const u32 words = (end + 3) / 4 - pc / 4;
+    u32 hash;
+    if (words > 0xffff || !HenHash(pc, words, hash)) {
+        return;
+    }
+    hen_jit_record_block(speculative ? hen_tag | 0x8000u : hen_tag, descriptor.Value(), words, hash);
+#else
+    (void)descriptor;
+    (void)end_location;
+    (void)speculative;
+#endif
+}

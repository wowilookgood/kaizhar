+// Upstream links a block to its target by rewriting an instruction in the block, whenever the
+// target is compiled or invalidated. Where code memory can't be writable while it is
+// executable (kaiHEN), each such rewrite means unmapping and mapping the cell of code memory
+// the block is in (~0.45 ms), and over half of all code updates in a large game were rewrites
+// of old blocks (measured in Super Smash Bros.: 10,539 of 18,651). Here a link site loads its
+// target from the target's slot instead: written once with the block, never rewritten, and
+// linking or unlinking is a store to the slot. Code memory is then only ever appended to.
+//
+// A slot is two words: [0] the target's entry point or 0 (a branch site falls through to the
+// dispatcher on 0), [1] the entry point or the dispatcher (what a return-stack push stores).
+std::array<u64, 2>* AddressSpace::HenLinkSlot(IR::LocationDescriptor target) {
+    if (const auto found = hen_link_slot_of.find(target); found != hen_link_slot_of.end()) {
+        return found->second;
+    }
+    const CodePtr entry = Get(target);
+    hen_link_slots.push_back({mcl::bit_cast<u64>(entry),
+                              mcl::bit_cast<u64>(entry ? static_cast<const void*>(entry)
+                                                       : static_cast<const void*>(prelude_info.return_to_dispatcher))});
+    std::array<u64, 2>* const slot = &hen_link_slots.back();
+    hen_link_slot_of.emplace(target, slot);
+    return slot;
+}
+
+/// What a B at site can reach (+-128 MiB, less the last instruction either way).
+static bool HenBranchReaches(CodePtr site, CodePtr target) {
+    const s64 distance = static_cast<s64>(mcl::bit_cast<u64>(target)) - static_cast<s64>(mcl::bit_cast<u64>(site));
+    return distance > -(s64(1) << 27) && distance < (s64(1) << 27);
+}
+
+// (Azahar's Switch 2 port) Compact link sites (hen_compact_links; emit_arm64_a32.cpp).
+//
+// A link site in the slot form is six instructions, and what an unlinked exit does is three
+// or four more: nine or ten words at every exit of every block, of which one runs once the
+// site is a direct branch. They sat between the blocks' code, so half of what the processor
+// fetched around a hot block was never executed (176 bytes a block, 3 or 4 instructions of the
+// program). A compact site is one instruction in the block:
+//
+//     B target        the target is compiled and within reach
+//     B stub          otherwise
+//
+// and the stub is the old site and its unlinked exit, once per target instead of once per
+// site, written here and not by the block's emitter:
+//
+//     stub:  MOVZ/MOVK/MOVK X16, the target's link slot
+//            LDR  X16, [X16]
+//            CBZ  X16, unlinked
+//            BR   X16
+//  unlinked: MOVZ/MOVK W16, the target's program counter
+//            STR  W16, [Xstate, pc]
+//            B    return_to_dispatcher (or its exit counter)
+//
+// Stubs lie in runs of their own (16 KiB taken from the code cursor when a run is full), so
+// they don't share cache lines or pages with blocks; where old code is costly to change (no
+// writable view of mapped code: hen_jit.c's pieces), a stub follows the block that first needs it.
+//
+// What may change in code that is running, and who changes it:
+//   - A stub is written once, before any site that leads to it can run, and never again.
+//     What it does changes through the link slot it reads: data, as for any link.
+//   - A site changes once, from "B stub" to "B target": one instruction, written by the
+//     emulation thread (HenUpgradeLinks) under hen_compile_mutex when the target is published.
+//     Before and after are both right at any moment: the stub reads the slot, which already
+//     holds the target. There is no way back: when the target is invalidated its slot is
+//     zeroed (stub: unlinked exit) and its first instructions become the same unlinked exit
+//     (HenTombstone), which is where "B target" then leads.
+//   - The compile worker writes only code that isn't published yet (new blocks, new stubs) and
+//     link slots (deferred to after the publish, as for any link).
+/// The ten instructions of a link stub (see above), at stub in the buffer given: for the code in
+/// use and for a re-sort's copy alike.
+void AddressSpace::HenWriteStub(u32* wmem, u32* xmem, CodePtr stub, u64 slot, u32 pc, size_t pc_offset, void* exit) {
+    using namespace oaknut;
+    using namespace oaknut::util;
+
+    constexpr size_t stub_bytes = 10 * sizeof(u32);
+    ASSERT(slot < (u64(1) << 48));
+    CodeGenerator c{wmem, xmem};
+    c.set_xptr(reinterpret_cast<u32*>(stub));
+    c.dw(0xD2800000u | (0u << 21) | (static_cast<u32>(slot & 0xffff) << 5) | 16u);          // MOVZ X16, #slot[15:0]
+    c.dw(0xF2800000u | (1u << 21) | (static_cast<u32>((slot >> 16) & 0xffff) << 5) | 16u);  // MOVK X16, #slot[31:16], LSL #16
+    c.dw(0xF2800000u | (2u << 21) | (static_cast<u32>((slot >> 32) & 0xffff) << 5) | 16u);  // MOVK X16, #slot[47:32], LSL #32
+    c.LDR(Xscratch0, Xscratch0);
+    c.dw(0xB4000000u | (2u << 5) | 16u);                                                    // CBZ X16, +8
+    c.BR(Xscratch0);
+    c.dw(0x52800000u | ((pc & 0xffff) << 5) | 16u);                                         // MOVZ W16, #pc[15:0]
+    c.dw(0x72a00000u | (((pc >> 16) & 0xffff) << 5) | 16u);                                 // MOVK W16, #pc[31:16], LSL #16
+    c.STR(Wscratch0, Xstate, pc_offset);
+    c.B(exit);
+    ASSERT(c.xptr<CodePtr>() == stub + stub_bytes);
+}
+
+CodePtr AddressSpace::HenLinkStub(IR::LocationDescriptor target, CodePtr site) {
+    using namespace oaknut;
+    using namespace oaknut::util;
+
+    if (const auto found = hen_link_stub_of.find(target); found != hen_link_stub_of.end() && HenBranchReaches(site, found->second)) {
+        return found->second;
+    }
+    constexpr size_t stub_bytes = 10 * sizeof(u32);
+    if (hen_stub_next == nullptr || static_cast<size_t>(hen_stub_end - hen_stub_next) < stub_bytes || !HenBranchReaches(site, hen_stub_next)) {
+        // A new run, from the code cursor: right after the block being linked.
+        HenFlushLinkStubs();
+        const size_t run = hen_jit_alias_active() ? 400 * stub_bytes : stub_bytes;
+        hen_stub_next = hen_stub_dirty = code.xptr<CodePtr>();
+        hen_stub_end = hen_stub_next + run;
+        code.set_offset(code.offset() + static_cast<std::ptrdiff_t>(run));
+    }
+    const CodePtr stub = hen_stub_next;
+    hen_stub_next += stub_bytes;
+    ASSERT(HenBranchReaches(site, stub));
+
+    const u64 slot = mcl::bit_cast<u64>(HenLinkSlot(target));
+    HenWriteStub(mem.wptr(), mem.xptr(), stub, slot, static_cast<u32>(target.Value()), hen_pc_offset,
+                 prelude_info.hen_exit_unlinked ? prelude_info.hen_exit_unlinked : prelude_info.return_to_dispatcher);
+
+    hen_link_stub_of.insert_or_assign(target, stub);
+    hen_jit_note_compact(3, 1);
+    return stub;
+}
+
+/// The stubs written since the last call are reported as changed code (one range: they are
+/// written in address order within a run). Before anything that leads to them can run:
+/// ProtectCodeMemory calls this.
+void AddressSpace::HenFlushLinkStubs() {
+    if (hen_stub_dirty != nullptr && hen_stub_next > hen_stub_dirty) {
+        mem.invalidate(reinterpret_cast<u32*>(hen_stub_dirty), static_cast<size_t>(hen_stub_next - hen_stub_dirty));
     }
+    hen_stub_dirty = hen_stub_next;
+}
+
+void AddressSpace::HenWriteLinkSites(const CodePtr entry_point, IR::LocationDescriptor target, const std::vector<BlockRelocation>& block_relocations_list) {
+    using namespace oaknut;
+    using namespace oaknut::util;
+
+    const u64 slot = mcl::bit_cast<u64>(HenLinkSlot(target));
+    ASSERT(slot < (u64(1) << 48));
+    // Direct links (hen_direct_links). A slot costs a data load on every block transition,
+    // from a table of megabytes laid out in compile order: measured at a fifth of the
+    // emulation thread's time in a title's steady state, and one of the larger stalls in
+    // generated code. When the target already exists as this block is written, the site is a
+    // plain branch (or the target's address, for a return-stack push) instead. Such a site is
+    // never rewritten: when its target is invalidated, the target's own first instructions
+    // become a jump to the dispatcher (HenTombstone), so code memory stays append-only apart
+    // from that one write per invalidated block.
+    const CodePtr direct = hen_direct_links ? Get(target) : nullptr;
+    for (auto [ptr_offset, type] : block_relocations_list) {
+        CodeGenerator c{mem.wptr(), mem.xptr()};
+        c.set_xptr(reinterpret_cast<u32*>(entry_point + ptr_offset));
+        if (type == BlockRelocationType::BranchCompact) {
+            // One instruction (see HenLinkStub): to the target if it is there, to its stub
+            // otherwise. HenUpgradeLinks turns the second into the first, and nothing ever
+            // turns it back (an invalidated target gets HenTombstone).
+            const CodePtr site = entry_point + ptr_offset;
+            if (direct && HenBranchReaches(site, direct)) {
+                c.B((void*)direct);
+                hen_jit_note_link(0);
+                hen_jit_note_compact(0, 1);
+                continue;
+            }
+            c.B((void*)HenLinkStub(target, site));
+            hen_jit_note_link(1);
+            hen_jit_note_compact(1, 1);
+            if (hen_direct_links) {
+                hen_pending_sites[target].push_back({site, type, entry_point});
+            }
+            continue;
+        }
+        if (direct) {
+            const s64 distance = static_cast<s64>(mcl::bit_cast<u64>(direct)) - static_cast<s64>(mcl::bit_cast<u64>(entry_point + ptr_offset));
+            if (type == BlockRelocationType::Branch && distance > -(s64(1) << 27) && distance < (s64(1) << 27)) {
+                c.B((void*)direct);
+                hen_jit_note_link(0);
+                continue;  // (the five instructions after it are never reached)
+            }
+            if (type == BlockRelocationType::MoveToScratch1) {
+                c.ADRL(Xscratch1, (void*)direct);
+                c.NOP();
+                c.NOP();
+                hen_jit_note_link(0);
+                continue;
+            }
+        }
+        hen_jit_note_link(1);
+        if (hen_direct_links) {
+            hen_pending_sites[target].push_back({entry_point + ptr_offset, type, entry_point});
+        }
+        // (always three instructions: MOVZ and two MOVKs, encoded by hand so that a zero
+        // chunk doesn't change their number or which bits they set)
+        const auto load_address = [&c](XReg reg, u64 address) {
+            const u32 rd = static_cast<u32>(reg.index());
+            c.dw(0xD2800000u | (0u << 21) | (static_cast<u32>(address & 0xffff) << 5) | rd);
+            c.dw(0xF2800000u | (1u << 21) | (static_cast<u32>((address >> 16) & 0xffff) << 5) | rd);
+            c.dw(0xF2800000u | (2u << 21) | (static_cast<u32>((address >> 32) & 0xffff) << 5) | rd);
+        };
+        switch (type) {
+        case BlockRelocationType::Branch: {
+            Label unlinked;
+            load_address(Xscratch0, slot);
+            c.LDR(Xscratch0, Xscratch0);
+            c.CBZ(Xscratch0, unlinked);
+            c.BR(Xscratch0);
+            c.l(unlinked);
+            break;
+        }
+        case BlockRelocationType::MoveToScratch1:
+            load_address(Xscratch1, slot + 8);
+            c.LDR(Xscratch1, Xscratch1);
+            break;
+        default:
+            ASSERT_FALSE("Invalid BlockRelocationType");
+        }
+    }
+}
+
+// (Azahar's Switch 2 port) Most links point forward, to a block compiled after the one that
+// branches to it, so their sites are written in the slot form (HenWriteLinkSites). This turns
+// them into direct branches once the target exists: a few hundred sites a call, from the
+// emulation thread between frames (HenBlockList::UpgradeLinks). Safe there because generated
+// code runs on that thread only, and a link site contains no call, so the thread is never in
+// the middle of one while it is out here. Returns the number of sites rewritten.
+size_t AddressSpace::HenUpgradeLinks(u64 deadline_ns, size_t max_sites) {
+    using namespace oaknut;
+    using namespace oaknut::util;
+
+    size_t done = 0;
+#if defined(__SWITCH__)
+    // (the count, not the vector: the worker adds to the vector under the lock this thread
+    // doesn't hold yet, and taking the lock every frame would cut its batches short)
+    if (!hen_direct_links || !hen_link_table || hen_ready_count.load(std::memory_order_relaxed) == 0 || hen_parked.load(std::memory_order_relaxed)) {
+        return 0;
+    }
+    // (Not worth a wait: when the worker has the lock, try again next frame. If half a
+    // second of that ends in a wait for the lock, with the worker asked to end its batch, the
+    // worker can take 58 ms over that: a gap of 59 ms between two frames with nothing
+    // else in it. The upgrade only makes links faster, so it never waits.)
+    std::unique_lock hen_lock{hen_compile_mutex, std::try_to_lock};
+    if (!hen_lock.owns_lock()) {
+        hen_jit_note_link_skip(1);
+        return 0;
+    }
+    hen_jit_note_link_skip(0);
+    bool open = false;
+    while (!hen_ready_targets.empty() && done < max_sites && hen_jit_now_ns() < deadline_ns) {
+        const IR::LocationDescriptor target = hen_ready_targets.back();
+        hen_ready_targets.pop_back();
+        const auto pending = hen_pending_sites.find(target);
+        if (pending == hen_pending_sites.end()) {
+            continue;
+        }
+        const CodePtr target_ptr = Get(target);
+        if (!target_ptr) {
+            continue;  // (invalidated since: the sites wait for the next time it is compiled)
+        }
+        for (const HenSlotSite& site : pending->second) {
+            const bool branch = site.type == BlockRelocationType::Branch || site.type == BlockRelocationType::BranchCompact;
+            if (branch && !HenBranchReaches(site.site, target_ptr)) {
+                continue;
+            }
+            // (a site in the first four instructions of a block invalidated since: those are
+            // the block's tombstone now, and must stay it)
+            if (static_cast<size_t>(site.site - site.block) < 4 * sizeof(u32) && hen_tombstoned.contains(site.block)) {
+                hen_jit_note_compact(5, 1);
+                continue;
+            }
+            if (!open) {
+                UnprotectCodeMemory();
+                open = true;
+            }
+            CodeGenerator c{mem.wptr(), mem.xptr()};
+            c.set_xptr(reinterpret_cast<u32*>(site.site));
+            if (branch) {
+                // (one instruction: "B stub" or the slot form's first, to "B target")
+                c.B((void*)target_ptr);
+                mem.invalidate(reinterpret_cast<u32*>(site.site), sizeof(u32));
+                if (site.type == BlockRelocationType::BranchCompact) {
+                    hen_jit_note_compact(2, 1);
+                }
+            } else {
+                c.ADRL(Xscratch1, (void*)target_ptr);
+                c.NOP();
+                c.NOP();
+                mem.invalidate(reinterpret_cast<u32*>(site.site), 4 * sizeof(u32));
+            }
+            done++;
+        }
+        hen_pending_sites.erase(pending);
+    }
+    if (open) {
+        ProtectCodeMemory();
+    }
+    hen_ready_count.store(hen_ready_targets.size(), std::memory_order_relaxed);
+    hen_jit_note_link_upgrades(done);
+#endif
+    return done;
+}

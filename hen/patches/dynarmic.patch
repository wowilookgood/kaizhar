+/// This address space's share of the totals "hen: layout:" reports (hen/jit/hen_jit.c): blocks
+/// and bytes in sorted order, blocks and bytes compiled since. Under the compile lock.
+void AddressSpace::HenResortCounts([[maybe_unused]] u64 sorted_blocks, [[maybe_unused]] u64 sorted_bytes, [[maybe_unused]] u64 unsorted_blocks, [[maybe_unused]] u64 unsorted_bytes) {
+    HEN_STAT(const u64 now[4] = {sorted_blocks, sorted_bytes, unsorted_blocks, unsorted_bytes};
+    for (int i = 0; i < 4; i++) {
+        hen_resort_note(i, static_cast<long long>(now[i]) - static_cast<long long>(hen_resort_mine[i]));
+        hen_resort_mine[i] = now[i];
+    })
+}

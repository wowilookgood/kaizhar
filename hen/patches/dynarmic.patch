+    std::vector<IR::LocationDescriptor> ready;
+    std::vector<HenLogEntry> log;
+    HEN_STAT(std::vector<u32> old_offsets;)  ///< per entry of log: where the block was copied from (for the checks)
+
+    size_t sorted_blocks = 0, appended_blocks = 0;
+    u64 sorted_bytes = 0, appended_bytes = 0;
+    size_t checked = 0, checked_top = 0;
+    unsigned rounds = 0;
+    u64 ready_ns = 0;
+    // (for the development builds' report of a re-sort)
+    HEN_STAT(size_t direct_sites = 0, slot_sites = 0, stubs = 0;
+    u64 figure = 0;
+    u64 start_ns = 0, copy_ns = 0, link_ns = 0, publish_ns = 0, publish_longest_ns = 0, check_ns = 0, map_ns = 0;
+    unsigned publish_requests = 0;)
+    const char* fail = nullptr;
+    u64 fail_at = 0;
+    bool fail_is_check = false;
+
+    void Mark(size_t begin, size_t end) {
+        dirty_bytes += end - begin;
+        for (auto range = dirty.rbegin(); range != dirty.rend(); ++range) {
+            if (begin >= range->first && begin <= range->second) {
+                range->second = std::max(range->second, end);
+                return;
+            }
+        }
+        dirty.emplace_back(begin, end);
+    }
+};

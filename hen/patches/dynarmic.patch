+// (Azahar's Switch 2 port) Re-sorting the code in the background.
+//
+// Why, the order, the checks and the numbers: Azahar's hen/jit/hen_resort.h. How, here.
+//
+// The copy ("world") is everything that holds a host code address, made anew for a second code
+// buffer: the buffer with its own prelude at the same offsets (the prelude's code is relative
+// throughout; the one address of itself it holds as data is set again), the blocks, the block
+// tables, the link slots, the link stubs, the records of link sites still to be upgraded, and
+// the log of blocks. Nothing of the code in use is changed while the copy is made, and the copy
+// refers to nothing of it: the code in use goes on running, compiling and linking as it is.
+//
+// Who does what:
+//   - The emulation thread's tick (HenResortTick, once a frame) decides that a re-sort begins.
+//   - The compile worker builds the copy between its batches (HenResortWork: one bounded step a
+//     turn, each under the compile lock for as long as it reads the tables in use, ended as a
+//     batch is when the emulation thread wants the lock). The steps: the blocks alive now, from
+//     the log (the snapshot); their order and offsets, and the copy's block table, so that every
+//     link between two of them is a direct branch from the start; each block's bytes copied and
+//     its calls into the prelude and its link sites written for the new addresses; then the
+//     blocks compiled meanwhile, appended in compile order, round after round until none is
+//     left; published in pieces as it goes; in development builds, checked.
+//   - The emulation thread changes over at the start of a slice (HenResortSwitch, from
+//     Jit::Run before generated code is entered): it appends the blocks compiled since the
+//     worker's last round, publishes them, and swaps the buffer, the prelude's addresses and
+//     every table for the copy's; the dispatcher's table is emptied. No host code address of
+//     this address space is live on that thread at that point: the return stack buffer and the
+//     saved registers of generated code are on the host stack only inside a slice, and the
+//     state between slices holds program values only.
+//   - The worker then frees what the old code needed and reports. The old buffer is kept as the
+//     next re-sort's (or released: --jit-resort-release).
+//
+// What ends a re-sort without a change-over: blocks invalidated or the cache cleared while the
+// copy was being made (the copy has code that is gone: it is thrown away, and the tick starts
+// another later), the process ending (HenPark), no second buffer, a failed check. The code in
+// use is untouched in every such case.
+#if defined(__SWITCH__)
+extern "C" {
+extern int hen_resort_release; // --jit-resort-release
+extern int hen_resort_poison;  // --jit-resort-poison
+int hen_resort_claim(void);
+void hen_resort_unclaim(void);
+unsigned hen_resort_number(void);
+unsigned long long hen_resort_origin(void);
+unsigned long long hen_resort_busy_last(void);
+int hen_jit_resort_prepare(struct hen_jit* jit, unsigned long long* map_ns);
+void hen_jit_resort_publish(struct hen_jit* jit, size_t begin, size_t size, unsigned long long* ns, unsigned* requests, unsigned long long* longest_ns);
+}
+
+struct AddressSpace::HenResortWorld {
+    struct hen_jit* jit = nullptr;  ///< the buffer the copy is made in; after the change-over, the old one
+    u32* w = nullptr;               ///< its write area
+    u32* x = nullptr;               ///< its execute address
+    const u32* old_w = nullptr;     ///< the buffer in use while the copy is made
+    CodePtr old_x = nullptr;
+    size_t usable = 0;
+    size_t old_usable = 0;          ///< the length of the buffer in use while the copy is made
+    size_t grow_from = 0;           ///< not 0: this re-sort is a growth from a buffer of that size
+    PreludeInfo prelude{};
+    CodePtr defer_stub = nullptr;
+    unsigned number = 0;
+    int phase = 0;        ///< 0 snapshot, 1 order, 2 copy, 3 what was compiled since
+    size_t snap = 0;      ///< log entries in the snapshot
+    size_t cursor = 0;
+    size_t log_done = 0;  ///< entries of the log in use that are in the copy (or dead)
+    std::vector<HenResort::Item> items;
+    size_t top = 0;       ///< the copy's code ends here
+    size_t old_top = 0;
